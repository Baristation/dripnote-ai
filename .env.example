APP_NAME=dripnote-ai
APP_ENV=local
INTERNAL_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=4

TRAIN_DEVICE=cpu

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=baristation-products
QDRANT_VECTOR_SIZE=1536
QDRANT_TOP_K=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=dripnote-ai

BACKEND_MYSQL_HOST=
BACKEND_MYSQL_PORT=8005
BACKEND_MYSQL_DATABASE=dripnote
BACKEND_MYSQL_USER=ai_readonly
BACKEND_MYSQL_PASSWORD=
